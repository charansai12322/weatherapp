# Groq API Credentials (required)
# The notebook previously referenced the key as 'groq'.
# Both GROQ_API_KEY and groq are supported.
GROQ_API_KEY=

# OpenWeatherMap API Credentials (required)
WEATHER_API_KEY=

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Optional Server Port (default: 8000)
PORT=8000
